# URL del webhook "Catch Hook" de Zapier (solo servidor, nunca llega al navegador)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/
# Secreto compartido que Zapier debe enviar en el header x-callback-secret
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLBACK_SECRET=cambia-este-secreto
# (Opcional) Preguntas por minuto y por IP en /api/chat; 0 desactiva el límite. Por defecto 10.
RATE_LIMIT_PER_MIN=10
