---
export const prerender = false;
const suggestions = [
  { icon: 'dig', title: '¿Qué es un dígrafo?' },
  { icon: 'mat', title: '¿Cómo se representa un dígrafo con la matriz de adyacencia?' },
  { icon: 'tor', title: '¿Qué es un torneo?' },
  { icon: 'deg', title: '¿Qué son el grado de entrada y el grado de salida de un vértice?' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tutor de grafos dirigidos</title>
    <meta name="description" content="Tutor académico de grafos dirigidos (dígrafos)." />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23c96442'/%3E%3Cpath d='M9 22 L22 10 M22 10 h-7 M22 10 v7' stroke='white' stroke-width='2.6' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="layout" id="layout">
      <aside class="sidebar" id="sidebar" aria-label="Conversaciones">
        <div class="side-top">
          <div class="brand">
            <span class="logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 23 L23 9" /><path d="M23 9h-8M23 9v8" /></svg>
            </span>
            <span class="brand-name">Grafos Dirigidos</span>
          </div>
          <button type="button" class="icon-btn only-mobile" id="close-side" aria-label="Cerrar menú">✕</button>
        </div>

        <button type="button" class="new-chat" id="new-chat">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Nueva conversación
        </button>

        <nav class="recents" aria-label="Recientes">
          <h2>Recientes</h2>
          <ul id="chat-list"></ul>
          <p class="no-recents" id="no-recents">Aún no hay conversaciones.</p>
        </nav>

        <footer class="side-foot">Tutor de grafos dirigidos</footer>
      </aside>

      <div class="scrim" id="scrim" hidden></div>

      <div class="main">
        <header class="bar">
          <button type="button" class="icon-btn only-mobile" id="open-side" aria-label="Abrir menú">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
          <h1 class="chat-title" id="chat-title">Nueva conversación</h1>
        </header>

        <main class="stage" id="stage" data-empty="true">
          <div class="thread-scroll" id="thread-scroll">
            <div class="thread" id="thread" role="log" aria-live="polite" aria-label="Conversación" tabindex="0"></div>
          </div>

          <section class="hero" id="hero">
            <svg class="spark" viewBox="0 0 64 64" aria-hidden="true">
              <defs>
                <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="currentColor"></path></marker>
              </defs>
              <g stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" marker-end="url(#arr)">
                <path d="M17 44 L27 24" /><path d="M31 21 L48 36" /><path d="M46 44 Q32 56 20 50" />
              </g>
              <g fill="currentColor"><circle cx="14" cy="49" r="5" /><circle cx="29" cy="19" r="5" /><circle cx="51" cy="40" r="5" /></g>
            </svg>
            <h2>¿Qué grafo exploramos hoy?</h2>
            <p>Pregúntame sobre dígrafos, representaciones, torneos y más.</p>
          </section>

          <div class="composer-wrap" id="composer-wrap">
            <div class="error" id="error" role="alert" hidden></div>
            <form class="composer" id="form">
              <label for="input" class="sr-only">Tu pregunta</label>
              <textarea id="input" rows="1" maxlength="2000" placeholder="¿En qué te puedo ayudar con grafos dirigidos?"></textarea>
              <div class="composer-foot">
                <span class="count" id="count" aria-hidden="true"></span>
                <button type="submit" id="send" aria-label="Enviar pregunta">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
                </button>
              </div>
            </form>
            <p class="disclaimer">Enter envía · Shift+Enter nueva línea. El tutor puede cometer errores: verifica lo importante.</p>
          </div>

          <div class="suggestions" id="suggestions">
            {suggestions.map((s) => (
              <button type="button" class="sugg" data-suggestion={s.title}>
                <span class="sicon" aria-hidden="true">
                  {s.icon === 'dig' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="2.5" /><circle cx="18" cy="7" r="2.5" /><path d="M8 15.5 L15.5 8.8M15.5 8.8h-4M15.5 8.8v4" /></svg>}
                  {s.icon === 'mat' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 12h16M12 4v16" /></svg>}
                  {s.icon === 'tor' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18 L8 8 L12 14 L16 8 L20 18 Z" /></svg>}
                  {s.icon === 'deg' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M3 12h6M6.5 9.5 9 12l-2.5 2.5M15 12h6M18.5 9.5 21 12l-2.5 2.5" /></svg>}
                </span>
                <span>{s.title}</span>
              </button>
            ))}
          </div>
        </main>
      </div>
    </div>

    <script>
      import { marked } from 'marked';
      import DOMPurify from 'dompurify';

      const POLL_MS = 2000;
      const MAX_WAIT_MS = 120_000;
      const STORAGE_KEY = 'grafos-chat-v1';
      const MAX_CHATS = 40;

      const $ = (id) => document.getElementById(id);
      const layout = $('layout');
      const stage = $('stage');
      const thread = $('thread');
      const threadScroll = $('thread-scroll');
      const form = $('form');
      const input = $('input');
      const send = $('send');
      const errorBox = $('error');
      const count = $('count');
      const chatList = $('chat-list');
      const noRecents = $('no-recents');
      const chatTitle = $('chat-title');
      const scrim = $('scrim');

      // ---------- Estado persistente (solo conveniencia del navegador) ----------
      let chats = [];
      try {
        chats = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        if (!Array.isArray(chats)) chats = [];
      } catch {
        chats = [];
      }
      function persist() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(chats.slice(0, MAX_CHATS)));
        } catch {}
      }

      let activeId = null; // null = conversación nueva (aún sin mensajes)
      let busy = false;
      let pendingChatId = null;

      const activeChat = () => chats.find((c) => c.id === activeId) || null;

      // ---------- Render ----------
      function renderList() {
        chatList.replaceChildren();
        noRecents.hidden = chats.length > 0;
        for (const c of chats) {
          const li = document.createElement('li');
          li.className = c.id === activeId ? 'active' : '';
          const open = document.createElement('button');
          open.type = 'button';
          open.className = 'chat-item';
          open.textContent = c.title;
          open.title = c.title;
          if (c.id === activeId) open.setAttribute('aria-current', 'true');
          open.addEventListener('click', () => selectChat(c.id));
          const del = document.createElement('button');
          del.type = 'button';
          del.className = 'del';
          del.setAttribute('aria-label', `Eliminar conversación: ${c.title}`);
          del.textContent = '✕';
          del.addEventListener('click', () => deleteChat(c.id));
          li.append(open, del);
          chatList.appendChild(li);
        }
      }

      function messageRow(role, text) {
        const row = document.createElement('div');
        row.className = `msg ${role}`;
        const body = document.createElement('div');
        body.className = 'body';
        const label = document.createElement('span');
        label.className = 'sr-only';
        label.textContent = role === 'user' ? 'Tú: ' : 'Tutor: ';
        body.append(label);
        if (role === 'user') {
          body.append(document.createTextNode(text));
        } else {
          const md = document.createElement('div');
          md.className = 'md';
          md.innerHTML = DOMPurify.sanitize(marked.parse(text));
          md.querySelectorAll('a').forEach((a) => {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          });
          body.append(md);
        }
        row.append(body);
        return row;
      }

      function typingRow() {
        const row = document.createElement('div');
        row.className = 'msg agent';
        row.id = 'typing';
        row.innerHTML =
          '<div class="body typing"><svg class="mini-spark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="17" r="2.4"/><circle cx="12" cy="6" r="2.4"/><circle cx="19" cy="15" r="2.4"/></svg><span>Preparando la respuesta</span><i></i><i></i><i></i></div>';
        return row;
      }

      function renderThread({ scroll = true } = {}) {
        const chat = activeChat();
        const hasMessages = !!chat && chat.messages.length > 0;
        stage.dataset.empty = hasMessages ? 'false' : 'true';
        thread.replaceChildren();
        if (chat) for (const m of chat.messages) thread.appendChild(messageRow(m.role, m.text));
        if (busy && pendingChatId === activeId) thread.appendChild(typingRow());
        chatTitle.textContent = chat ? chat.title : 'Nueva conversación';
        document.title = chat ? `${chat.title} · Tutor de grafos` : 'Tutor de grafos dirigidos';
        if (scroll) scrollDown();
      }
      function scrollDown() {
        threadScroll.scrollTo({ top: threadScroll.scrollHeight, behavior: 'smooth' });
      }
      function renderAll() {
        renderList();
        renderThread();
      }

      // ---------- UI helpers ----------
      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.hidden = false;
      }
      function clearError() {
        errorBox.hidden = true;
        errorBox.textContent = '';
      }
      function setBusy(value) {
        busy = value;
        send.disabled = value;
        input.disabled = value;
        if (!value) input.focus();
      }
      function autosize() {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 200) + 'px';
        const n = input.value.length;
        count.textContent = n > 1500 ? `${n}/2000` : '';
      }
      function closeSidebar() {
        layout.classList.remove('side-open');
        scrim.hidden = true;
      }
      function openSidebar() {
        layout.classList.add('side-open');
        scrim.hidden = false;
      }

      function selectChat(id) {
        activeId = id;
        clearError();
        renderAll();
        closeSidebar();
      }
      function newChat() {
        activeId = null;
        clearError();
        renderAll();
        closeSidebar();
        input.focus();
      }
      function deleteChat(id) {
        if (busy && pendingChatId === id) return;
        chats = chats.filter((c) => c.id !== id);
        persist();
        if (activeId === id) activeId = null;
        renderAll();
      }

      // ---------- Envío ----------
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      async function ask(message) {
        if (busy) return;
        clearError();

        let chat = activeChat();
        if (!chat) {
          chat = {
            id: crypto.randomUUID(),
            title: message.length > 42 ? message.slice(0, 42).trimEnd() + '…' : message,
            messages: [],
            updated: Date.now(),
          };
          chats.unshift(chat);
          activeId = chat.id;
        }
        chat.messages.push({ role: 'user', text: message });
        chat.updated = Date.now();
        persist();

        pendingChatId = chat.id;
        setBusy(true);
        input.value = '';
        autosize();
        renderAll();

        try {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'No se pudo enviar la pregunta.');

          const started = Date.now();
          while (true) {
            if (Date.now() - started > MAX_WAIT_MS) {
              throw new Error('Tiempo agotado: el tutor no respondió en 2 minutos. Inténtalo de nuevo.');
            }
            await sleep(POLL_MS);
            const poll = await fetch(`/api/chat/${data.conversationId}`, { cache: 'no-store' });
            if (poll.status === 404) throw new Error('La conversación expiró. Vuelve a preguntar.');
            if (!poll.ok) throw new Error('Error al consultar la respuesta.');
            const state = await poll.json();
            if (state.status === 'done') {
              chat.messages.push({ role: 'agent', text: state.response });
              chat.updated = Date.now();
              persist();
              break;
            }
          }
        } catch (err) {
          showError(err instanceof TypeError ? 'Error de red. Revisa tu conexión.' : err.message);
        } finally {
          pendingChatId = null;
          setBusy(false);
          renderAll();
        }
      }

      // ---------- Eventos ----------
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const message = input.value.trim();
        if (message) ask(message);
      });
      input.addEventListener('input', autosize);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          e.preventDefault();
          form.requestSubmit();
        }
      });
      document.querySelectorAll('[data-suggestion]').forEach((btn) =>
        btn.addEventListener('click', () => ask(btn.getAttribute('data-suggestion'))),
      );
      $('new-chat').addEventListener('click', newChat);
      $('open-side').addEventListener('click', openSidebar);
      $('close-side').addEventListener('click', closeSidebar);
      scrim.addEventListener('click', closeSidebar);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSidebar();
      });

      renderAll();
      autosize();
    </script>

    <style is:global>
      :root {
        --bg: #faf9f5;
        --side: #f0eee6;
        --surface: #ffffff;
        --text: #29261b;
        --muted: #73706a;
        --accent: #c96442;
        --accent-soft: rgba(201, 100, 66, 0.1);
        --border: #e4e1d6;
        --hover: rgba(41, 38, 27, 0.06);
        --user-bg: #efece2;
        --danger-bg: #fdecea;
        --danger: #a8281b;
        --shadow: 0 2px 4px rgba(41, 38, 27, 0.04), 0 8px 28px -12px rgba(41, 38, 27, 0.18);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #262624;
          --side: #1f1e1d;
          --surface: #30302e;
          --text: #ece9df;
          --muted: #a29f94;
          --accent: #d97757;
          --accent-soft: rgba(217, 119, 87, 0.14);
          --border: #3d3c38;
          --hover: rgba(236, 233, 223, 0.07);
          --user-bg: #1f1e1d;
          --danger-bg: #3a1c19;
          --danger: #ffb4a8;
          --shadow: 0 2px 4px rgba(0, 0, 0, 0.2), 0 10px 30px -12px rgba(0, 0, 0, 0.6);
        }
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      button { font: inherit; color: inherit; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .layout { display: flex; height: 100dvh; }

      /* ---------- Sidebar ---------- */
      .sidebar {
        flex: none; width: 288px; background: var(--side); border-right: 1px solid var(--border);
        display: flex; flex-direction: column; padding: 14px 12px; gap: 14px;
      }
      .side-top { display: flex; align-items: center; justify-content: space-between; padding: 2px 6px; }
      .brand { display: flex; align-items: center; gap: 10px; }
      .logo {
        width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center;
        background: var(--accent); color: #fff;
      }
      .brand-name {
        font-family: Georgia, 'Times New Roman', serif; font-size: 1.2rem; font-weight: 500; white-space: nowrap;
      }
      .new-chat {
        display: flex; align-items: center; gap: 10px; width: 100%; cursor: pointer;
        background: var(--accent-soft); color: var(--accent); border: 1px solid transparent;
        border-radius: 12px; padding: 10px 12px; font-weight: 600; font-size: 0.95rem;
        transition: background .15s;
      }
      .new-chat:hover { background: rgba(201, 100, 66, 0.18); }
      .recents { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; }
      .recents h2 {
        margin: 6px 8px; font-size: 0.74rem; font-weight: 600; letter-spacing: .06em;
        text-transform: uppercase; color: var(--muted);
      }
      .recents ul { list-style: none; margin: 0; padding: 0; }
      .recents li { position: relative; display: flex; border-radius: 10px; }
      .recents li:hover, .recents li.active { background: var(--hover); }
      .chat-item {
        flex: 1; min-width: 0; text-align: left; background: none; border: 0; cursor: pointer;
        padding: 8px 10px; border-radius: 10px; font-size: 0.92rem; line-height: 1.4;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .recents li.active .chat-item { font-weight: 600; }
      .del {
        flex: none; width: 30px; background: none; border: 0; cursor: pointer; color: var(--muted);
        opacity: 0; border-radius: 8px; font-size: 0.75rem;
      }
      .recents li:hover .del, .del:focus-visible { opacity: 1; }
      .del:hover { color: var(--danger); }
      .no-recents { margin: 8px; color: var(--muted); font-size: 0.88rem; }
      .side-foot { padding: 8px 8px 2px; color: var(--muted); font-size: 0.78rem; border-top: 1px solid var(--border); }

      .icon-btn {
        width: 36px; height: 36px; display: grid; place-items: center; background: none; border: 0;
        border-radius: 10px; cursor: pointer; color: var(--text);
      }
      .icon-btn:hover { background: var(--hover); }
      .only-mobile { display: none; }
      .scrim { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.4); z-index: 20; }

      /* ---------- Main ---------- */
      .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
      .bar { display: flex; align-items: center; gap: 8px; padding: 10px 20px; min-height: 56px; }
      .chat-title {
        margin: 0; font-size: 0.95rem; font-weight: 500; color: var(--muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .stage {
        flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center;
        padding: 0 24px 16px;
      }
      .stage[data-empty='true'] { justify-content: center; padding-bottom: 8vh; }
      .stage[data-empty='true'] .thread-scroll { display: none; }
      .stage[data-empty='false'] .hero,
      .stage[data-empty='false'] .suggestions { display: none; }

      /* Hero */
      .hero { text-align: center; margin-bottom: 32px; animation: rise .5s ease both; }
      .spark { width: 60px; height: 60px; color: var(--accent); margin-bottom: 10px; }
      .hero h2 {
        margin: 0 0 10px; font-family: Georgia, 'Times New Roman', serif; font-weight: 400;
        font-size: clamp(1.9rem, 4.5vw, 2.7rem); line-height: 1.15; letter-spacing: -0.015em;
        text-wrap: balance;
      }
      .hero p { margin: 0 auto; max-width: 46ch; color: var(--muted); font-size: 1.02rem; text-wrap: balance; }

      /* Hilo */
      .thread-scroll { flex: 1; width: 100%; min-height: 0; overflow-y: auto; scrollbar-width: thin; }
      .thread {
        width: 100%; max-width: 760px; margin: 0 auto; padding: 12px 0 24px;
        display: flex; flex-direction: column; gap: 26px; outline-offset: 4px;
      }
      .msg { display: flex; animation: rise .3s ease both; }
      .msg.user { justify-content: flex-end; }
      .msg.user .body {
        max-width: 80%; background: var(--user-bg); padding: 10px 16px; border-radius: 18px;
        white-space: pre-wrap; overflow-wrap: anywhere;
      }
      .msg.agent .body { width: 100%; overflow-wrap: anywhere; }
      .md > :first-child { margin-top: 0; }
      .md > :last-child { margin-bottom: 0; }
      .md h1, .md h2, .md h3 {
        font-family: Georgia, 'Times New Roman', serif; font-weight: 600; line-height: 1.3; margin: 1.3em 0 0.4em;
      }
      .md h1 { font-size: 1.5rem; }
      .md h2 { font-size: 1.28rem; }
      .md h3 { font-size: 1.1rem; }
      .md p { margin: 0.7em 0; }
      .md ul, .md ol { padding-left: 1.4em; margin: 0.6em 0; }
      .md li { margin: 0.3em 0; }
      .md li::marker { color: var(--accent); }
      .md a { color: var(--accent); }
      .md blockquote {
        margin: 0.8em 0; padding: 2px 16px; border-left: 3px solid var(--accent); color: var(--muted);
      }
      .md code {
        font: 0.87em ui-monospace, 'Cascadia Code', Consolas, monospace;
        background: var(--hover); padding: 2px 6px; border-radius: 6px;
      }
      .md pre {
        overflow-x: auto; background: var(--side); border: 1px solid var(--border);
        padding: 14px; border-radius: 12px;
      }
      .md pre code { background: none; padding: 0; }
      .md table { display: block; overflow-x: auto; border-collapse: collapse; margin: 0.8em 0; }
      .md th, .md td { border: 1px solid var(--border); padding: 6px 12px; }
      .md th { background: var(--side); }
      .md hr { border: 0; border-top: 1px solid var(--border); margin: 1.2em 0; }

      .typing { display: flex; align-items: center; gap: 4px; color: var(--muted); }
      .mini-spark { width: 22px; height: 22px; fill: var(--accent); margin-right: 6px; animation: pulse 1.6s infinite; }
      .typing i {
        width: 5px; height: 5px; border-radius: 50%; background: var(--accent); animation: bounce 1.2s infinite both;
      }
      .typing i:nth-of-type(2) { animation-delay: .15s; }
      .typing i:nth-of-type(3) { animation-delay: .3s; }

      /* Composer */
      .composer-wrap { width: 100%; max-width: 760px; }
      .error {
        background: var(--danger-bg); color: var(--danger); border-radius: 12px;
        padding: 10px 14px; margin-bottom: 10px; font-size: 0.93rem;
      }
      .composer {
        background: var(--surface); border: 1px solid var(--border); border-radius: 22px;
        padding: 16px 14px 12px 20px; box-shadow: var(--shadow);
        transition: border-color .15s, box-shadow .15s;
      }
      .composer:focus-within { border-color: var(--accent); box-shadow: var(--shadow), 0 0 0 3px var(--accent-soft); }
      .composer textarea {
        display: block; width: 100%; resize: none; border: 0; background: transparent; color: var(--text);
        font: inherit; line-height: 1.55; min-height: 28px; max-height: 200px; outline: none; padding: 0;
      }
      .composer textarea::placeholder { color: var(--muted); }
      .composer-foot { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 6px; }
      .count { font-size: 0.74rem; color: var(--muted); }
      .composer-foot button {
        width: 36px; height: 36px; border-radius: 10px; border: 0; cursor: pointer; color: #fff;
        background: var(--accent); display: grid; place-items: center; transition: filter .15s, transform .15s;
      }
      .composer-foot button:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
      .composer-foot button:disabled, .composer textarea:disabled { opacity: .5; cursor: not-allowed; }
      .disclaimer { margin: 10px 0 0; text-align: center; color: var(--muted); font-size: 0.76rem; }
      .stage[data-empty='true'] .disclaimer { display: none; }

      /* Sugerencias */
      .suggestions {
        width: 100%; max-width: 760px; margin-top: 20px; display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; animation: rise .6s ease both;
      }
      .sugg {
        display: flex; align-items: center; gap: 12px; text-align: left; cursor: pointer;
        background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
        padding: 12px 16px 12px 12px; min-height: 72px; font-size: 0.92rem; line-height: 1.4;
        text-wrap: pretty; transition: border-color .15s, background-color .15s;
      }
      .sugg:hover { border-color: var(--accent); }
      .sugg:hover .sicon { background: var(--accent); color: #fff; }
      .sicon {
        flex: none; width: 40px; height: 40px; border-radius: 12px; color: var(--accent);
        background: var(--accent-soft); display: grid; place-items: center; transition: background-color .15s, color .15s;
      }

      @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @keyframes bounce { 0%, 80%, 100% { transform: translateY(0); opacity: .4; } 40% { transform: translateY(-4px); opacity: 1; } }
      @keyframes pulse { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }

      /* ---------- Móvil ---------- */
      @media (max-width: 820px) {
        .only-mobile { display: grid; }
        .sidebar {
          position: fixed; inset: 0 auto 0 0; z-index: 30; width: min(300px, 86vw);
          transform: translateX(-100%); transition: transform .22s ease;
        }
        .layout.side-open .sidebar { transform: none; box-shadow: 0 0 40px rgba(0, 0, 0, 0.3); }
        .bar { padding: 8px 12px; }
        .stage { padding: 0 14px 12px; }
        .stage[data-empty='true'] { padding-bottom: 4vh; }
        .msg.user .body { max-width: 90%; }
        .suggestions { grid-template-columns: 1fr; gap: 10px; }
        .sugg { min-height: 64px; }
        .disclaimer { font-size: 0.7rem; }
      }
    </style>
  </body>
</html>
