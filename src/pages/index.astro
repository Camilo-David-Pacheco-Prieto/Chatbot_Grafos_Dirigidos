---
export const prerender = false;
const suggestions = [
  { icon: 'dig', label: 'Dígrafo', title: '¿Qué es un dígrafo?' },
  { icon: 'mat', label: 'Matriz', title: '¿Cómo se representa un dígrafo con la matriz de adyacencia?' },
  { icon: 'tor', label: 'Torneo', title: '¿Qué es un torneo?' },
  { icon: 'deg', label: 'Grados', title: '¿Qué son el grado de entrada y el grado de salida de un vértice?' },
  { icon: 'cam', label: 'Caminos y ciclos', title: '¿Qué es un camino dirigido y qué es un ciclo en un dígrafo?' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Tutor de grafos dirigidos</title>
    <meta name="description" content="Tutor académico de grafos dirigidos (dígrafos)." />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23c96442'/%3E%3Cpath d='M9 22 L22 10 M22 10 h-7 M22 10 v7' stroke='white' stroke-width='2.6' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="layout" id="layout">
      <aside class="sidebar" id="sidebar" aria-label="Conversaciones">
        <div class="side-top">
          <div class="brand">
            <span class="logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 23 L23 9" /><path d="M23 9h-8M23 9v8" /></svg>
            </span>
            <span class="brand-name">Grafos dirigidos</span>
          </div>
          <button type="button" class="icon-btn" id="close-side" aria-label="Cerrar menú">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="3" /><path d="M9.5 4.5v15" /></svg>
          </button>
        </div>

        <button type="button" class="nav-item" id="new-chat">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          Nueva conversación
        </button>

        <nav class="recents" aria-label="Recientes">
          <div class="recents-head">
            <h2>Recientes</h2>
            <button type="button" class="icon-btn small" id="sort-btn" aria-label="Agrupar y ordenar" title="Agrupar y ordenar" aria-haspopup="menu"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h7M17 8h3M4 16h3M13 16h7" /><circle cx="14" cy="8" r="2" /><circle cx="10" cy="16" r="2" /></svg></button>
          </div>
          <input type="search" class="search-input" id="search-input" placeholder="Buscar conversaciones" aria-label="Buscar conversaciones" hidden />
          <div id="chat-list"></div>
          <p class="no-recents" id="no-recents">Tus conversaciones aparecerán aquí.</p>
        </nav>

        <footer class="side-foot">
          <button type="button" class="user-btn" id="user-btn" aria-haspopup="menu" aria-label="Opciones de la cuenta">
            <span class="avatar" aria-hidden="true">CP</span>
            <span class="who"><strong>Camilo Pacheco</strong><small>Teoría de Grafos</small></span>
          </button>
          <button type="button" class="icon-btn" id="search-btn" aria-label="Buscar conversaciones" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
          </button>
        </footer>
      </aside>

      <div class="scrim" id="scrim" hidden></div>

      <div class="main">
        <header class="bar" id="bar">
          <button type="button" class="icon-btn" id="open-side" aria-label="Abrir menú">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="3" /><path d="M9.5 4.5v15" /></svg>
          </button>
          <h1 class="chat-title" id="chat-title">Nueva conversación</h1>
          <button type="button" class="icon-btn small" id="chat-menu-btn" aria-label="Opciones de la conversación" aria-haspopup="menu" hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 10 4 4 4-4" /></svg></button>
          <button type="button" class="icon-btn only-mobile" id="new-chat-bar" aria-label="Nueva conversación">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </button>
        </header>

        <main class="stage" id="stage" data-empty="true">
          <div class="thread-scroll" id="thread-scroll">
            <div class="thread" id="thread" role="log" aria-live="polite" aria-label="Conversación" tabindex="0"></div>
          </div>

          <section class="hero" id="hero">
            <h2>
              <svg class="spark" viewBox="0 0 64 64" aria-hidden="true">
                <defs>
                  <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="currentColor"></path></marker>
                </defs>
                <g stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round" marker-end="url(#arr)">
                  <path d="M17 44 L27 24" /><path d="M31 21 L48 36" /><path d="M46 44 Q32 56 20 50" />
                </g>
                <g fill="currentColor"><circle cx="14" cy="49" r="5" /><circle cx="29" cy="19" r="5" /><circle cx="51" cy="40" r="5" /></g>
              </svg>
              <span id="greeting"><span class="g-hi" id="g-hi">Hola</span><span class="g-q">. ¿Qué grafo exploramos?</span></span>
            </h2>
          </section>

          <div class="composer-wrap" id="composer-wrap">
            <div class="error" id="error" role="alert" hidden></div>
            <form class="composer" id="form">
              <label for="input" class="sr-only">Tu pregunta</label>
              <textarea id="input" rows="1" maxlength="2000" placeholder="Pregunta sobre grafos dirigidos"></textarea>
              <span class="count" id="count" aria-hidden="true"></span>
              <button type="submit" id="send" aria-label="Enviar pregunta">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
              </button>
            </form>
          </div>

          <div class="suggestions" id="suggestions">
            {suggestions.map((s) => (
              <button type="button" class="sugg" data-suggestion={s.title}>
                <span class="sicon" aria-hidden="true">
                  {s.icon === 'dig' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="2.5" /><circle cx="18" cy="7" r="2.5" /><path d="M8 15.5 L15.5 8.8M15.5 8.8h-4M15.5 8.8v4" /></svg>}
                  {s.icon === 'mat' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 12h16M12 4v16" /></svg>}
                  {s.icon === 'tor' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18 L8 8 L12 14 L16 8 L20 18 Z" /></svg>}
                  {s.icon === 'cam' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="5.5" r="2" /><circle cx="19" cy="12" r="2" /><circle cx="12" cy="18.5" r="2" /><path d="M6.5 10.6 10.5 7M13.5 7 17.5 10.6M17.5 13.4 13.5 17M10.5 17 6.5 13.4" /></svg>}
                  {s.icon === 'deg' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M3 12h6M6.5 9.5 9 12l-2.5 2.5M15 12h6M18.5 9.5 21 12l-2.5 2.5" /></svg>}
                </span>
                <span>{s.label}</span>
              </button>
            ))}
          </div>
        </main>
        <footer class="foot">
          <p class="foot-ai">El tutor puede cometer errores. Verifica lo importante.</p>
          <p class="foot-src">Las respuestas se basan en el Capítulo 9 de <em>Graph Theory with Applications to Engineering and Computer Science</em>.</p>
        </footer>
      </div>
    </div>

    <div class="toast" id="toast" role="status" hidden></div>
    <dialog class="dlg" id="dlg">
      <form method="dialog">
        <h3 id="dlg-title"></h3>
        <p id="dlg-text" hidden></p>
        <input id="dlg-input" maxlength="80" autocomplete="off" hidden />
        <div class="dlg-actions">
          <button type="button" id="dlg-cancel">Cancelar</button>
          <button type="submit" id="dlg-ok" value="ok">Aceptar</button>
        </div>
      </form>
    </dialog>

    <script>
      import { marked } from 'marked';
      import DOMPurify from 'dompurify';

      const POLL_MS = 2000;
      const MAX_WAIT_MS = 120_000;
      const STORAGE_KEY = 'grafos-chat-v1';
      const SIDE_KEY = 'grafos-side-collapsed';
      const MAX_CHATS = 40;

      const $ = (id) => document.getElementById(id);
      const layout = $('layout');
      const sidebar = $('sidebar');
      const stage = $('stage');
      const thread = $('thread');
      const threadScroll = $('thread-scroll');
      const form = $('form');
      const input = $('input');
      const send = $('send');
      const errorBox = $('error');
      const count = $('count');
      const chatList = $('chat-list');
      const noRecents = $('no-recents');
      const chatTitle = $('chat-title');
      const scrim = $('scrim');
      const bar = $('bar');
      const isMobile = window.matchMedia('(max-width: 820px)');

      // ---------- Estado persistente (solo conveniencia del navegador) ----------
      let chats = [];
      try {
        chats = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        if (!Array.isArray(chats)) chats = [];
      } catch {
        chats = [];
      }
      function persist() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(chats.slice(0, MAX_CHATS)));
        } catch {}
      }

      let activeId = null; // null = conversación nueva (aún sin mensajes)
      let busy = false;
      let pendingChatId = null;

      const activeChat = () => chats.find((c) => c.id === activeId) || null;

      // ---------- Saludo ----------
      function greet() {
        const h = new Date().getHours();
        const when = h < 6 ? 'Buenas noches' : h < 12 ? 'Buenos días' : h < 20 ? 'Buenas tardes' : 'Buenas noches';
        $('g-hi').textContent = when;
      }

      // ---------- Preferencias de presentación (solo en este navegador) ----------
      const PREFS_KEY = 'grafos-prefs-v1';
      const prefs = { sort: 'recent', groupBy: 'none', collapsed: {}, theme: 'system' };
      try {
        Object.assign(prefs, JSON.parse(localStorage.getItem(PREFS_KEY) || '{}'));
      } catch {}
      if (!prefs.collapsed || typeof prefs.collapsed !== 'object') prefs.collapsed = {};
      function savePrefs() {
        try {
          localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
        } catch {}
      }
      function applyTheme() {
        if (prefs.theme === 'light' || prefs.theme === 'dark') document.documentElement.dataset.theme = prefs.theme;
        else document.documentElement.removeAttribute('data-theme');
      }

      // ---------- Íconos ----------
      const ico = (d, s = 18) =>
        `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
      const I = {
        pin: '<path d="M9 4h6l-1 5 3 3H7l3-3-1-5zM12 12v8" />',
        edit: '<path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4" />',
        folder: '<path d="M3.5 8A2 2 0 0 1 5.5 6H10l2 2h6.5a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2V8z" />',
        down: '<path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19h14" />',
        copy: '<rect x="9" y="9" width="11" height="11" rx="2.5" /><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" />',
        trash: '<path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12" />',
        check: '<path d="m5 12.5 4.5 4.5L19 7.5" />',
        more: '<circle cx="12" cy="5.5" r="1.4" fill="currentColor" /><circle cx="12" cy="12" r="1.4" fill="currentColor" /><circle cx="12" cy="18.5" r="1.4" fill="currentColor" />',
        sliders: '<path d="M4 8h7M17 8h3M4 16h3M13 16h7" /><circle cx="14" cy="8" r="2" /><circle cx="10" cy="16" r="2" />',
        chevron: '<path d="m8 10 4 4 4-4" />',
        back: '<path d="m14 7-5 5 5 5" />',
        plus: '<path d="M12 5v14M5 12h14" />',
      };

      // ---------- Avisos y diálogos ----------
      const toastEl = $('toast');
      let toastTimer = 0;
      function toast(msg, action) {
        clearTimeout(toastTimer);
        toastEl.replaceChildren(document.createTextNode(msg));
        if (action) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = action.label;
          b.addEventListener('click', () => {
            toastEl.hidden = true;
            action.run();
          });
          toastEl.append(b);
        }
        toastEl.hidden = false;
        toastTimer = setTimeout(() => (toastEl.hidden = true), action ? 6000 : 2500);
      }

      const dlg = $('dlg');
      const dlgInput = $('dlg-input');
      function dialog({ title, text = '', withInput = false, value = '', ok = 'Aceptar', danger = false }) {
        return new Promise((resolve) => {
          $('dlg-title').textContent = title;
          $('dlg-text').textContent = text;
          $('dlg-text').hidden = !text;
          dlgInput.hidden = !withInput;
          dlgInput.value = value;
          const okBtn = $('dlg-ok');
          okBtn.textContent = ok;
          okBtn.classList.toggle('danger', danger);
          dlg.returnValue = '';
          dlg.addEventListener(
            'close',
            () => resolve(dlg.returnValue === 'ok' ? (withInput ? dlgInput.value.trim() : true) : null),
            { once: true },
          );
          dlg.showModal();
          if (withInput) {
            dlgInput.focus();
            dlgInput.select();
          }
        });
      }

      // ---------- Menú contextual (hoja inferior en móvil) ----------
      let menuEl = null;
      let menuBack = null;
      let menuAnchor = null;
      function closeMenu({ refocus = false } = {}) {
        menuEl?.remove();
        menuBack?.remove();
        document.removeEventListener('pointerdown', onOutside, true);
        const a = menuAnchor;
        menuEl = menuBack = menuAnchor = null;
        if (refocus && a?.isConnected) a.focus();
      }
      function onOutside(e) {
        if (menuEl && !menuEl.contains(e.target) && !menuAnchor?.contains(e.target)) closeMenu();
      }
      function openMenu(anchor, items, { align = 'left' } = {}) {
        closeMenu();
        menuAnchor = anchor;
        const m = document.createElement('div');
        m.className = 'menu';
        m.setAttribute('role', 'menu');
        for (const it of items) {
          if (it === '-') {
            m.append(Object.assign(document.createElement('hr'), { className: 'menu-sep' }));
            continue;
          }
          if (it.header) {
            const h = document.createElement('div');
            h.className = 'menu-head';
            h.textContent = it.header;
            m.append(h);
            continue;
          }
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('role', 'menuitem');
          b.className = 'menu-item' + (it.danger ? ' danger' : '');
          b.innerHTML = `<span class="mi-ico">${it.icon ? ico(it.icon) : ''}</span><span class="mi-label"></span><span class="mi-end"></span>`;
          b.querySelector('.mi-label').textContent = it.label;
          const end = b.querySelector('.mi-end');
          if (it.checked) end.innerHTML = ico(I.check, 16);
          else if (it.sub) end.textContent = '›';
          else if (it.key) end.textContent = it.key;
          b.addEventListener('click', () => {
            if (it.sub) {
              openMenu(anchor, [{ label: 'Atrás', icon: I.back, run: () => openMenu(anchor, items, { align }) }, '-', ...it.sub], { align });
              menuEl?.querySelector('.menu-item')?.focus();
              return;
            }
            closeMenu();
            it.run?.();
          });
          b.dataset.key = it.key ? it.key.toLowerCase() : '';
          m.append(b);
        }
        m.addEventListener('keydown', (e) => {
          const btns = [...m.querySelectorAll('.menu-item')];
          const i = btns.indexOf(document.activeElement);
          if (e.key === 'ArrowDown') btns[(i + 1) % btns.length]?.focus();
          else if (e.key === 'ArrowUp') btns[(i - 1 + btns.length) % btns.length]?.focus();
          else if (e.key === 'Escape') closeMenu({ refocus: true });
          else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
            const hit = btns.find((b) => b.dataset.key === e.key.toLowerCase());
            if (hit) hit.click();
            else return;
          } else return;
          e.preventDefault();
          e.stopPropagation();
        });
        if (isMobile.matches) {
          menuBack = Object.assign(document.createElement('div'), { className: 'menu-back' });
          menuBack.addEventListener('click', () => closeMenu());
          document.body.append(menuBack);
          m.classList.add('sheet');
        }
        document.body.append(m);
        menuEl = m;
        if (!isMobile.matches) {
          const r = anchor.getBoundingClientRect();
          const w = m.offsetWidth;
          const h = m.offsetHeight;
          let left = align === 'right' ? r.right - w : r.left;
          left = Math.max(8, Math.min(left, innerWidth - w - 8));
          let top = r.bottom + 6;
          if (top + h > innerHeight - 8) top = Math.max(8, r.top - h - 6);
          m.style.left = left + 'px';
          m.style.top = top + 'px';
        }
        document.addEventListener('pointerdown', onOutside, true);
        m.querySelector('.menu-item')?.focus();
      }

      // ---------- Búsqueda ----------
      let query = '';
      const norm = (t) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      const searchInput = $('search-input');
      const searchBtn = $('search-btn');
      function toggleSearch(open = searchInput.hidden) {
        searchInput.hidden = !open;
        searchBtn.setAttribute('aria-expanded', String(open));
        if (open) searchInput.focus();
        else {
          searchInput.value = '';
          query = '';
          renderList();
        }
      }

      // ---------- Lista: secciones, orden y grupos ----------
      const byRecent = (a, b) => (b.updated || 0) - (a.updated || 0);
      function sortChats(list) {
        const a = [...list];
        if (prefs.sort === 'alpha') a.sort((x, y) => x.title.localeCompare(y.title, 'es'));
        else if (prefs.sort === 'oldest') a.sort((x, y) => byRecent(y, x));
        else a.sort(byRecent);
        return a;
      }
      const groupNames = () =>
        [...new Set(chats.filter((c) => c.group).map((c) => c.group))].sort((a, b) => a.localeCompare(b, 'es'));

      function buildSections(list) {
        const out = [];
        const pinned = list.filter((c) => c.pinned);
        const rest = list.filter((c) => !c.pinned);
        if (pinned.length) out.push({ key: 'pinned', title: 'Fijados', items: sortChats(pinned) });
        if (prefs.groupBy === 'custom') {
          for (const g of groupNames()) {
            const items = rest.filter((c) => c.group === g);
            if (items.length) out.push({ key: 'g:' + g, title: g, group: g, items: sortChats(items) });
          }
          const none = rest.filter((c) => !c.group);
          if (none.length) out.push({ key: 'chats', title: 'Chats', items: sortChats(none) });
        } else if (prefs.groupBy === 'date') {
          const today = new Date().setHours(0, 0, 0, 0);
          const day = 86_400_000;
          const buckets = [
            ['d0', 'Hoy', (u) => u >= today],
            ['d1', 'Ayer', (u) => u >= today - day],
            ['d7', 'Últimos 7 días', (u) => u >= today - 7 * day],
            ['d8', 'Anteriores', () => true],
          ];
          const left = [...rest];
          for (const [key, title, test] of buckets) {
            const items = left.filter((c) => test(c.updated || 0));
            for (const c of items) left.splice(left.indexOf(c), 1);
            if (items.length) out.push({ key, title, items: sortChats(items) });
          }
        } else if (rest.length) {
          out.push({ key: 'chats', title: 'Chats', items: sortChats(rest) });
        }
        return out;
      }

      function chatMenu(c) {
        const groups = groupNames();
        return [
          { label: c.pinned ? 'Quitar de fijados' : 'Fijar', icon: I.pin, key: 'P', run: () => togglePin(c) },
          { label: 'Cambiar nombre', icon: I.edit, key: 'R', run: () => renameChat(c) },
          {
            label: 'Mover al grupo',
            icon: I.folder,
            sub: [
              ...groups.map((g) => ({ label: g, icon: I.folder, checked: c.group === g, run: () => setGroup(c, g) })),
              { label: 'Nuevo grupo…', icon: I.plus, run: () => newGroupFor(c) },
              ...(c.group ? ['-', { label: 'Quitar del grupo', run: () => setGroup(c, null) }] : []),
            ],
          },
          '-',
          { label: 'Exportar como Markdown', icon: I.down, run: () => exportMarkdown(c) },
          { label: 'Copiar conversación', icon: I.copy, run: () => copyChat(c) },
          '-',
          { label: 'Eliminar', icon: I.trash, key: 'D', danger: true, run: () => removeChat(c) },
        ];
      }

      function renderList() {
        chatList.replaceChildren();
        const q = norm(query);
        const shown = q
          ? chats.filter((c) => norm(c.title).includes(q) || c.messages.some((m) => norm(m.text).includes(q)))
          : chats;
        noRecents.hidden = shown.length > 0;
        noRecents.textContent = chats.length ? 'Sin resultados.' : 'Tus conversaciones aparecerán aquí.';
        for (const sec of buildSections(shown)) {
          const wrap = document.createElement('section');
          wrap.className = 'sec';
          const collapsed = !!prefs.collapsed[sec.key] && !q;
          const head = document.createElement('div');
          head.className = 'sec-head';
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'sec-toggle';
          toggle.setAttribute('aria-expanded', String(!collapsed));
          toggle.innerHTML = `<span class="sec-chev${collapsed ? ' closed' : ''}">${ico(I.chevron, 14)}</span><span class="sec-name"></span><span class="sec-count">${sec.items.length}</span>`;
          toggle.querySelector('.sec-name').textContent = sec.title;
          toggle.addEventListener('click', () => {
            prefs.collapsed[sec.key] = !collapsed;
            savePrefs();
            renderList();
          });
          head.append(toggle);
          if (sec.group) {
            const gm = document.createElement('button');
            gm.type = 'button';
            gm.className = 'icon-btn small';
            gm.setAttribute('aria-label', `Opciones del grupo ${sec.group}`);
            gm.innerHTML = ico(I.more, 16);
            gm.addEventListener('click', () =>
              openMenu(gm, [
                { label: 'Cambiar nombre del grupo', icon: I.edit, run: () => renameGroup(sec.group) },
                { label: 'Eliminar grupo', icon: I.trash, danger: true, run: () => deleteGroup(sec.group) },
              ], { align: 'right' }),
            );
            head.append(gm);
          }
          wrap.append(head);
          if (!collapsed) {
            const ul = document.createElement('ul');
            for (const c of sec.items) ul.append(chatRow(c));
            wrap.append(ul);
          }
          chatList.append(wrap);
        }
      }

      function chatRow(c) {
        const li = document.createElement('li');
        li.className = c.id === activeId ? 'active' : '';
        const open = document.createElement('button');
        open.type = 'button';
        open.className = 'chat-item';
        open.textContent = c.title;
        open.title = c.title;
        if (c.id === activeId) open.setAttribute('aria-current', 'true');
        open.addEventListener('click', () => selectChat(c.id));
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'more';
        more.setAttribute('aria-label', `Opciones de la conversación: ${c.title}`);
        more.setAttribute('aria-haspopup', 'menu');
        more.innerHTML = ico(I.more, 18);
        more.addEventListener('click', () => openMenu(more, chatMenu(c), { align: 'right' }));
        li.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          openMenu(more, chatMenu(c), { align: 'right' });
        });
        li.append(open, more);
        return li;
      }

      // ---------- Acciones sobre conversaciones (solo presentación y datos locales) ----------
      function togglePin(c) {
        c.pinned = !c.pinned;
        persist();
        renderAll();
        toast(c.pinned ? 'Conversación fijada' : 'Conversación desfijada');
      }
      async function renameChat(c) {
        const name = await dialog({ title: 'Cambiar nombre', withInput: true, value: c.title, ok: 'Guardar' });
        if (!name) return;
        c.title = name.slice(0, 80);
        c.renamed = true;
        persist();
        renderAll();
      }
      function setGroup(c, name) {
        c.group = name;
        if (name && prefs.groupBy !== 'custom') {
          prefs.groupBy = 'custom';
          savePrefs();
        }
        persist();
        renderAll();
        toast(name ? `Movida a «${name}»` : 'Quitada del grupo');
      }
      async function newGroupFor(c) {
        const name = await dialog({ title: 'Nuevo grupo', withInput: true, ok: 'Crear' });
        if (name) setGroup(c, name.slice(0, 40));
      }
      async function renameGroup(g) {
        const name = await dialog({ title: 'Cambiar nombre del grupo', withInput: true, value: g, ok: 'Guardar' });
        if (!name || name === g) return;
        for (const c of chats) if (c.group === g) c.group = name.slice(0, 40);
        persist();
        renderAll();
      }
      async function deleteGroup(g) {
        const ok = await dialog({
          title: 'Eliminar grupo',
          text: `Las conversaciones de «${g}» no se borran: pasan a «Chats».`,
          ok: 'Eliminar grupo',
          danger: true,
        });
        if (!ok) return;
        for (const c of chats) if (c.group === g) c.group = null;
        persist();
        renderAll();
      }
      async function removeChat(c) {
        if (busy && pendingChatId === c.id) {
          toast('Espera a que termine la respuesta para eliminarla.');
          return;
        }
        const ok = await dialog({
          title: 'Eliminar conversación',
          text: `«${c.title}» se eliminará de este navegador.`,
          ok: 'Eliminar',
          danger: true,
        });
        if (!ok) return;
        const index = chats.indexOf(c);
        chats = chats.filter((x) => x !== c);
        const wasActive = activeId === c.id;
        if (wasActive) activeId = null;
        persist();
        renderAll();
        toast('Conversación eliminada', {
          label: 'Deshacer',
          run: () => {
            chats.splice(Math.min(index, chats.length), 0, c);
            if (wasActive) activeId = c.id;
            persist();
            renderAll();
          },
        });
      }
      const chatToMarkdown = (c) =>
        `# ${c.title}\n\n` + c.messages.map((m) => `**${m.role === 'user' ? 'Tú' : 'Tutor'}:**\n\n${m.text}`).join('\n\n---\n\n') + '\n';
      function download(name, text, type) {
        const url = URL.createObjectURL(new Blob([text], { type }));
        const a = Object.assign(document.createElement('a'), { href: url, download: name });
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      const slug = (t) => norm(t).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) || 'conversacion';
      function exportMarkdown(c) {
        download(`${slug(c.title)}.md`, chatToMarkdown(c), 'text/markdown');
        toast('Conversación exportada');
      }
      async function copyChat(c) {
        try {
          await navigator.clipboard.writeText(chatToMarkdown(c));
          toast('Conversación copiada');
        } catch {
          toast('No se pudo copiar.');
        }
      }

      // ---------- Menús de cabecera y pie ----------
      function sortMenu() {
        const pick = (k, v) => () => {
          prefs[k] = v;
          savePrefs();
          renderList();
        };
        return [
          { header: 'Ordenar por' },
          { label: 'Más recientes', checked: prefs.sort === 'recent', run: pick('sort', 'recent') },
          { label: 'Más antiguos', checked: prefs.sort === 'oldest', run: pick('sort', 'oldest') },
          { label: 'Alfabético', checked: prefs.sort === 'alpha', run: pick('sort', 'alpha') },
          '-',
          { header: 'Agrupar por' },
          { label: 'Sin agrupar', checked: prefs.groupBy === 'none', run: pick('groupBy', 'none') },
          { label: 'Por fecha', checked: prefs.groupBy === 'date', run: pick('groupBy', 'date') },
          { label: 'Mis grupos', checked: prefs.groupBy === 'custom', run: pick('groupBy', 'custom') },
        ];
      }
      function userMenu() {
        const theme = (v) => () => {
          prefs.theme = v;
          savePrefs();
          applyTheme();
        };
        return [
          { header: 'Tema' },
          { label: 'Según el sistema', checked: prefs.theme === 'system', run: theme('system') },
          { label: 'Claro', checked: prefs.theme === 'light', run: theme('light') },
          { label: 'Oscuro', checked: prefs.theme === 'dark', run: theme('dark') },
          '-',
          {
            label: 'Exportar todo (JSON)',
            icon: I.down,
            run: () => {
              download('conversaciones-grafos.json', JSON.stringify(chats, null, 2), 'application/json');
              toast('Historial exportado');
            },
          },
          { label: 'Borrar todo el historial', icon: I.trash, danger: true, run: clearAll },
        ];
      }
      async function clearAll() {
        if (busy) {
          toast('Espera a que termine la respuesta.');
          return;
        }
        if (!chats.length) return toast('No hay conversaciones.');
        const ok = await dialog({
          title: 'Borrar todo el historial',
          text: 'Se eliminarán todas las conversaciones de este navegador.',
          ok: 'Borrar todo',
          danger: true,
        });
        if (!ok) return;
        chats = [];
        activeId = null;
        persist();
        renderAll();
        toast('Historial borrado');
      }

      async function copyText(btn, text) {
        try {
          await navigator.clipboard.writeText(text);
          const prev = btn.innerHTML;
          btn.classList.add('ok');
          btn.textContent = 'Copiado';
          setTimeout(() => {
            btn.classList.remove('ok');
            btn.innerHTML = prev;
          }, 1500);
        } catch {}
      }
      const COPY_ICON =
        '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5" /><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" /></svg>';

      function messageRow(role, text) {
        const row = document.createElement('div');
        row.className = `msg ${role}`;
        const body = document.createElement('div');
        body.className = 'body';
        const label = document.createElement('span');
        label.className = 'sr-only';
        label.textContent = role === 'user' ? 'Tú: ' : 'Tutor: ';
        body.append(label);
        if (role === 'user') {
          body.append(document.createTextNode(text));
        } else {
          const md = document.createElement('div');
          md.className = 'md';
          md.innerHTML = DOMPurify.sanitize(marked.parse(text));
          md.querySelectorAll('a').forEach((a) => {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          });
          md.querySelectorAll('pre').forEach((pre) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'copy code-copy';
            b.setAttribute('aria-label', 'Copiar código');
            b.innerHTML = COPY_ICON;
            b.addEventListener('click', () => copyText(b, pre.querySelector('code')?.innerText ?? pre.innerText));
            pre.append(b);
          });
          body.append(md);
          const actions = document.createElement('div');
          actions.className = 'actions';
          const cp = document.createElement('button');
          cp.type = 'button';
          cp.className = 'copy';
          cp.setAttribute('aria-label', 'Copiar respuesta');
          cp.innerHTML = COPY_ICON;
          cp.addEventListener('click', () => copyText(cp, text));
          actions.append(cp);
          body.append(actions);
        }
        row.append(body);
        return row;
      }

      function typingRow() {
        const row = document.createElement('div');
        row.className = 'msg agent';
        row.id = 'typing';
        row.innerHTML =
          '<div class="body typing"><svg class="mini-spark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="17" r="2.4"/><circle cx="12" cy="6" r="2.4"/><circle cx="19" cy="15" r="2.4"/></svg><span>Preparando la respuesta</span></div>';
        return row;
      }

      function renderThread({ scroll = true } = {}) {
        const chat = activeChat();
        const hasMessages = !!chat && chat.messages.length > 0;
        stage.dataset.empty = hasMessages ? 'false' : 'true';
        bar.dataset.empty = hasMessages ? 'false' : 'true';
        thread.replaceChildren();
        if (chat) for (const m of chat.messages) thread.appendChild(messageRow(m.role, m.text));
        if (busy && pendingChatId === activeId) thread.appendChild(typingRow());
        chatTitle.textContent = chat ? chat.title : 'Nueva conversación';
        $('chat-menu-btn').hidden = !chat;
        document.title = chat ? `${chat.title} · Tutor de grafos` : 'Tutor de grafos dirigidos';
        if (scroll) scrollDown();
      }
      function scrollDown() {
        threadScroll.scrollTo({ top: threadScroll.scrollHeight, behavior: 'smooth' });
      }
      function renderAll() {
        renderList();
        renderThread();
      }

      // ---------- UI helpers ----------
      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.hidden = false;
      }
      function clearError() {
        errorBox.hidden = true;
        errorBox.textContent = '';
      }
      function setBusy(value) {
        busy = value;
        send.disabled = value;
        input.disabled = value;
        if (!value) input.focus();
      }
      function autosize() {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 200) + 'px';
        input.style.overflowY = input.scrollHeight > 200 ? 'auto' : 'hidden';
        const n = input.value.length;
        count.textContent = n > 1500 ? `${n}/2000` : '';
      }

      // Barra lateral: en móvil es un panel superpuesto; en escritorio se colapsa.
      function syncSide() {
        const open = isMobile.matches
          ? layout.classList.contains('side-open')
          : !layout.classList.contains('side-collapsed');
        sidebar.inert = !open;
        scrim.hidden = !(isMobile.matches && open);
      }
      function closeSidebar() {
        if (isMobile.matches) {
          layout.classList.remove('side-open');
        } else {
          layout.classList.add('side-collapsed');
          try {
            localStorage.setItem(SIDE_KEY, '1');
          } catch {}
        }
        syncSide();
      }
      function openSidebar() {
        if (isMobile.matches) {
          layout.classList.add('side-open');
        } else {
          layout.classList.remove('side-collapsed');
          try {
            localStorage.removeItem(SIDE_KEY);
          } catch {}
        }
        syncSide();
      }
      function dismissDrawer() {
        if (isMobile.matches) {
          layout.classList.remove('side-open');
          syncSide();
        }
      }

      function selectChat(id) {
        activeId = id;
        clearError();
        renderAll();
        dismissDrawer();
      }
      function newChat() {
        activeId = null;
        clearError();
        renderAll();
        dismissDrawer();
        input.focus();
      }
      // ---------- Envío ----------
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      async function ask(message) {
        if (busy) return;
        clearError();

        let chat = activeChat();
        if (!chat) {
          chat = {
            id: crypto.randomUUID(),
            title: message.length > 42 ? message.slice(0, 42).trimEnd() + '…' : message,
            messages: [],
            updated: Date.now(),
          };
          chats.unshift(chat);
          activeId = chat.id;
        }
        chat.messages.push({ role: 'user', text: message });
        chat.updated = Date.now();
        persist();

        pendingChatId = chat.id;
        setBusy(true);
        input.value = '';
        autosize();
        renderAll();

        try {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'No se pudo enviar la pregunta.');

          const started = Date.now();
          while (true) {
            if (Date.now() - started > MAX_WAIT_MS) {
              throw new Error('Tiempo agotado: el tutor no respondió en 2 minutos. Inténtalo de nuevo.');
            }
            await sleep(POLL_MS);
            const poll = await fetch(`/api/chat/${data.conversationId}`, { cache: 'no-store' });
            if (poll.status === 404) throw new Error('La conversación expiró. Vuelve a preguntar.');
            if (!poll.ok) throw new Error('Error al consultar la respuesta.');
            const state = await poll.json();
            if (state.status === 'done') {
              chat.messages.push({ role: 'agent', text: state.response });
              chat.updated = Date.now();
              persist();
              break;
            }
          }
        } catch (err) {
          showError(err instanceof TypeError ? 'Error de red. Revisa tu conexión.' : err.message);
        } finally {
          pendingChatId = null;
          setBusy(false);
          renderAll();
        }
      }

      // ---------- Eventos ----------
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const message = input.value.trim();
        if (message) ask(message);
      });
      input.addEventListener('input', autosize);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          e.preventDefault();
          form.requestSubmit();
        }
      });
      document.querySelectorAll('[data-suggestion]').forEach((btn) =>
        btn.addEventListener('click', () => ask(btn.getAttribute('data-suggestion'))),
      );
      $('new-chat').addEventListener('click', newChat);
      $('sort-btn').addEventListener('click', (e) => openMenu(e.currentTarget, sortMenu(), { align: 'right' }));
      $('user-btn').addEventListener('click', (e) => openMenu(e.currentTarget, userMenu()));
      $('chat-menu-btn').addEventListener('click', (e) => {
        const c = activeChat();
        if (c) openMenu(e.currentTarget, chatMenu(c));
      });
      $('dlg-cancel').addEventListener('click', () => dlg.close('cancel'));
      searchBtn.addEventListener('click', () => toggleSearch());
      searchInput.addEventListener('input', () => {
        query = searchInput.value;
        renderList();
      });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggleSearch(false);
      });
      $('new-chat-bar').addEventListener('click', newChat);
      $('open-side').addEventListener('click', openSidebar);
      $('close-side').addEventListener('click', closeSidebar);
      scrim.addEventListener('click', closeSidebar);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMobile.matches) dismissDrawer();
      });
      isMobile.addEventListener('change', () => {
        layout.classList.remove('side-open');
        syncSide();
      });
      threadScroll.addEventListener('scroll', () => {
        bar.classList.toggle('scrolled', threadScroll.scrollTop > 4);
      });

      try {
        if (localStorage.getItem(SIDE_KEY)) layout.classList.add('side-collapsed');
      } catch {}
      applyTheme();
      greet();
      syncSide();
      renderAll();
      autosize();
    </script>

    <style is:global>
      :root {
        --bg: #faf9f5;
        --side: #f3f1ea;
        --surface: #ffffff;
        --text: #26231b;
        --muted: #77746b;
        --accent: #c96442;
        --accent-soft: rgba(201, 100, 66, 0.1);
        --border: #e6e3d8;
        --hover: rgba(38, 35, 27, 0.06);
        --user-bg: #efece2;
        --danger-bg: #fdecea;
        --danger: #a8281b;
        --shadow: 0 1px 2px rgba(38, 35, 27, 0.04), 0 6px 24px -10px rgba(38, 35, 27, 0.16);
        --serif: Georgia, 'Times New Roman', serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #161616;
          --side: #1c1c1b;
          --surface: #212120;
          --text: #ebe8de;
          --muted: #9b988e;
          --accent: #d97757;
          --accent-soft: rgba(217, 119, 87, 0.14);
          --border: #302f2c;
          --hover: rgba(235, 232, 222, 0.07);
          --user-bg: #262624;
          --danger-bg: #3a1c19;
          --danger: #ffb4a8;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 28px -12px rgba(0, 0, 0, 0.6);
        }
      }
      :root[data-theme='light'] {
        color-scheme: light;
        --bg: #faf9f5; --side: #f3f1ea; --surface: #ffffff; --text: #26231b; --muted: #77746b;
        --accent: #c96442; --accent-soft: rgba(201, 100, 66, 0.1); --border: #e6e3d8;
        --hover: rgba(38, 35, 27, 0.06); --user-bg: #efece2; --danger-bg: #fdecea; --danger: #a8281b;
        --shadow: 0 1px 2px rgba(38, 35, 27, 0.04), 0 6px 24px -10px rgba(38, 35, 27, 0.16);
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --bg: #161616; --side: #1c1c1b; --surface: #212120; --text: #ebe8de; --muted: #9b988e;
        --accent: #d97757; --accent-soft: rgba(217, 119, 87, 0.14); --border: #302f2c;
        --hover: rgba(235, 232, 222, 0.07); --user-bg: #262624; --danger-bg: #3a1c19; --danger: #ffb4a8;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 28px -12px rgba(0, 0, 0, 0.6);
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      button { font: inherit; color: inherit; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .layout { display: flex; height: 100dvh; overflow: hidden; }

      /* ---------- Sidebar ---------- */
      .sidebar {
        flex: none; width: 280px; background: var(--side); border-right: 1px solid var(--border);
        display: flex; flex-direction: column; padding: 12px 10px 10px; gap: 6px;
        transition: margin-left .22s ease;
      }
      .layout.side-collapsed .sidebar { margin-left: -281px; }
      .side-top { display: flex; align-items: center; justify-content: space-between; padding: 2px 4px 8px 8px; }
      .brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
      .logo {
        flex: none; width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center;
        background: var(--accent); color: #fff;
      }
      .brand-name { font-family: var(--serif); font-size: 1.2rem; font-weight: 500; white-space: nowrap; }
      .nav-item {
        display: flex; align-items: center; gap: 12px; width: 100%; cursor: pointer;
        background: none; border: 0; border-radius: 10px; padding: 9px 10px; font-size: 0.95rem;
        text-align: left; transition: background-color .15s;
      }
      .nav-item svg { color: var(--accent); }
      .nav-item:hover { background: var(--hover); }
      .recents { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; margin-top: 14px; }
      .recents-head { display: flex; align-items: center; justify-content: space-between; margin: 0 2px 4px 0; }
      .recents h2 { margin: 0 10px; font-size: 0.82rem; font-weight: 500; color: var(--muted); }
      .recents ul { list-style: none; margin: 0; padding: 0; }
      .recents li { position: relative; display: flex; align-items: center; border-radius: 10px; }
      .recents li:hover, .recents li.active { background: var(--hover); }
      .chat-item {
        flex: 1; min-width: 0; text-align: left; background: none; border: 0; cursor: pointer;
        padding: 8px 10px; border-radius: 10px; font-size: 0.92rem; line-height: 1.4;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .sec { margin-bottom: 10px; }
      .sec-head { display: flex; align-items: center; }
      .sec-toggle {
        flex: 1; display: flex; align-items: center; gap: 4px; background: none; border: 0; cursor: pointer;
        color: var(--muted); font-size: 0.82rem; padding: 6px 8px; border-radius: 8px; text-align: left;
      }
      .sec-toggle:hover { color: var(--text); }
      .sec-chev { display: grid; transition: transform .15s; }
      .sec-chev.closed { transform: rotate(-90deg); }
      .sec-count { margin-left: auto; font-size: 0.74rem; opacity: .7; }
      .more {
        flex: none; width: 0; height: 32px; overflow: hidden; display: grid; place-items: center; align-self: center;
        background: none; border: 0; border-radius: 8px; color: var(--muted); cursor: pointer; opacity: 0; padding: 0;
      }
      .recents li:hover .more, .recents li.active .more, .more:focus-visible, .more[aria-expanded] { width: 32px; opacity: 1; }
      .more:hover { background: var(--hover); color: var(--text); }
      .user-btn {
        flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; background: none; border: 0;
        border-radius: 10px; padding: 4px 6px; cursor: pointer; color: inherit; text-align: left;
      }
      .user-btn:hover { background: var(--hover); }
      .menu {
        position: fixed; z-index: 60; min-width: 230px; max-width: min(320px, 92vw); background: var(--surface);
        border: 1px solid var(--border); border-radius: 14px; padding: 6px;
        box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.4);
      }
      .menu-item {
        display: flex; align-items: center; gap: 10px; width: 100%; background: none; border: 0; border-radius: 9px;
        padding: 9px 10px; cursor: pointer; text-align: left; font-size: 0.93rem;
      }
      .menu-item:hover, .menu-item:focus-visible { background: var(--hover); outline: none; }
      .menu-item.danger { color: var(--danger); }
      .mi-ico { width: 18px; display: grid; place-items: center; color: var(--muted); }
      .menu-item.danger .mi-ico { color: inherit; }
      .mi-label { flex: 1; }
      .mi-end { display: grid; color: var(--muted); font-size: 0.8rem; }
      .menu-sep { border: 0; border-top: 1px solid var(--border); margin: 6px 4px; }
      .menu-head { padding: 6px 10px 2px; font-size: 0.78rem; color: var(--muted); }
      .menu-back { position: fixed; inset: 0; z-index: 55; background: rgba(0, 0, 0, 0.45); }
      .menu.sheet {
        left: 0; right: 0; bottom: 0; top: auto; max-width: none; border-radius: 20px 20px 0 0;
        padding: 10px 10px calc(14px + env(safe-area-inset-bottom)); max-height: 80dvh; overflow: auto;
        animation: sheet .2s ease;
      }
      .menu.sheet .menu-item { min-height: 48px; }
      @keyframes sheet { from { transform: translateY(30px); opacity: 0; } }
      .toast {
        position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 70; display: flex; gap: 14px;
        align-items: center; max-width: 90vw; padding: 10px 16px; border-radius: 12px; font-size: 0.9rem;
        background: var(--text); color: var(--bg); box-shadow: 0 8px 28px -8px rgba(0, 0, 0, 0.5);
      }
      .toast[hidden] { display: none; }
      .toast button { background: none; border: 0; color: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
      .dlg {
        width: min(380px, 92vw); padding: 20px; border: 1px solid var(--border); border-radius: 18px;
        background: var(--surface); color: var(--text);
      }
      .dlg::backdrop { background: rgba(0, 0, 0, 0.5); }
      .dlg h3 { margin: 0 0 8px; font-family: var(--serif); font-weight: 500; font-size: 1.15rem; }
      .dlg p { margin: 0 0 12px; color: var(--muted); font-size: 0.92rem; }
      .dlg input {
        width: 100%; margin: 4px 0 12px; padding: 10px 12px; font: inherit; color: var(--text); background: var(--bg);
        border: 1px solid var(--border); border-radius: 10px; outline: none;
      }
      .dlg input[hidden], .dlg p[hidden] { display: none; }
      .dlg input:focus { border-color: var(--accent); }
      .dlg-actions { display: flex; justify-content: flex-end; gap: 8px; }
      .dlg-actions button {
        padding: 9px 16px; border-radius: 10px; border: 1px solid var(--border); background: none; cursor: pointer;
      }
      .dlg-actions button:hover { background: var(--hover); }
      #dlg-ok { background: var(--accent); border-color: transparent; color: #fff; }
      #dlg-ok:hover { filter: brightness(1.1); background: var(--accent); }
      #dlg-ok.danger { background: #c0392b; }
      .del {
        position: absolute; right: 2px; width: 30px; height: 30px; display: grid; place-items: center;
        background: var(--side); border: 0; cursor: pointer; color: var(--muted);
        opacity: 0; border-radius: 8px;
      }
      .recents li:hover .del, .del:focus-visible { opacity: 1; }
      .del:hover { color: var(--danger); }
      .search-input { width: calc(100% - 20px); margin: 0 10px 8px; padding: 8px 12px; font: inherit; font-size: 0.9rem; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; outline: none; }
      .search-input:focus { border-color: var(--accent); }
      #search-btn { margin-left: auto; }
      .no-recents { margin: 8px 10px; color: var(--muted); font-size: 0.88rem; }
      .side-foot {
        display: flex; align-items: center; gap: 10px; padding: 10px 8px 2px; margin-top: 4px;
        border-top: 1px solid var(--border); color: var(--muted); font-size: 0.86rem;
      }
      .who { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
      .who strong { color: var(--text); font-weight: 500; }
      .who small { font-size: 0.78rem; }
      .avatar {
        width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
        background: var(--accent-soft); color: var(--accent); font-weight: 600; font-size: 0.8rem;
      }

      .icon-btn {
        flex: none; width: 40px; height: 40px; display: grid; place-items: center; background: none; border: 0;
        border-radius: 10px; cursor: pointer; color: var(--muted); transition: background-color .15s, color .15s;
      }
      .icon-btn:hover { background: var(--hover); color: var(--text); }
      #open-side { display: none; }
      .layout.side-collapsed #open-side { display: grid; }
      .only-mobile { display: none; }
      .icon-btn[hidden] { display: none; }
      .icon-btn.small { width: 32px; height: 32px; }
      #new-chat-bar { margin-left: auto; }
      .scrim { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); z-index: 20; }

      /* ---------- Main ---------- */
      .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
      .bar {
        display: flex; align-items: center; gap: 6px; padding: 8px 14px; min-height: 56px;
        border-bottom: 1px solid transparent; transition: border-color .2s;
      }
      .bar.scrolled { border-bottom-color: var(--border); }
      .chat-title {
        flex: 0 1 auto; min-width: 0; margin: 0; font-size: 0.95rem; font-weight: 500; color: var(--muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .bar[data-empty='true'] .chat-title { visibility: hidden; }
      .bar[data-empty='false'] .chat-title { color: var(--text); }
      .stage {
        flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center;
        padding: 0 24px 16px;
      }
      .stage[data-empty='true'] { justify-content: center; padding-bottom: 10vh; }
      .stage[data-empty='true'] .thread-scroll { display: none; }
      .stage[data-empty='false'] .hero,
      .stage[data-empty='false'] .suggestions { display: none; }

      /* Saludo */
      .hero { margin-bottom: 28px; animation: rise .5s ease both; }
      .hero h2 {
        display: flex; align-items: center; justify-content: center; gap: 12px; margin: 0; white-space: nowrap;
        font-family: var(--serif); font-weight: 400; font-size: clamp(1.8rem, 4vw, 2.5rem);
        line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance; text-align: center;
      }
      .spark { flex: none; width: 1.3em; height: 1.3em; color: var(--accent); }

      /* Hilo */
      .thread-scroll { flex: 1; width: 100%; min-height: 0; overflow-y: auto; scrollbar-width: thin; }
      .thread {
        width: 100%; max-width: 760px; margin: 0 auto; padding: 16px 0 28px;
        display: flex; flex-direction: column; gap: 28px; outline-offset: 4px;
      }
      .msg { display: flex; animation: rise .3s ease both; }
      .msg.user { justify-content: flex-end; }
      .msg.user .body {
        max-width: 80%; background: var(--user-bg); padding: 10px 16px; border-radius: 18px;
        white-space: pre-wrap; overflow-wrap: anywhere;
      }
      .msg.agent .body { width: 100%; overflow-wrap: anywhere; line-height: 1.7; }
      .actions { display: flex; margin-top: 6px; }
      .copy {
        display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 8px; border: 0;
        background: none; border-radius: 8px; color: var(--muted); cursor: pointer; font-size: 0.8rem;
      }
      .copy:hover, .copy.ok { background: var(--hover); color: var(--text); }
      .md > :first-child { margin-top: 0; }
      .md > :last-child { margin-bottom: 0; }
      .md h1, .md h2, .md h3 { font-family: var(--serif); font-weight: 600; line-height: 1.3; margin: 1.4em 0 0.4em; }
      .md h1 { font-size: 1.5rem; }
      .md h2 { font-size: 1.28rem; }
      .md h3 { font-size: 1.1rem; }
      .md p { margin: 0.75em 0; }
      .md ul, .md ol { padding-left: 1.4em; margin: 0.6em 0; }
      .md li { margin: 0.3em 0; }
      .md li::marker { color: var(--accent); }
      .md a { color: var(--accent); }
      .md blockquote { margin: 0.8em 0; padding: 2px 16px; border-left: 3px solid var(--accent); color: var(--muted); }
      .md code {
        font: 0.87em ui-monospace, 'Cascadia Code', Consolas, monospace;
        background: var(--hover); padding: 2px 6px; border-radius: 6px;
      }
      .md pre {
        position: relative; overflow-x: auto; background: var(--side); border: 1px solid var(--border);
        padding: 14px 44px 14px 14px; border-radius: 12px;
      }
      .md pre code { background: none; padding: 0; }
      .code-copy { position: absolute; top: 6px; right: 6px; padding: 0; width: 30px; justify-content: center; }
      .md table { display: block; overflow-x: auto; border-collapse: collapse; margin: 0.8em 0; }
      .md th, .md td { border: 1px solid var(--border); padding: 6px 12px; }
      .md th { background: var(--side); }
      .md hr { border: 0; border-top: 1px solid var(--border); margin: 1.2em 0; }

      .typing { display: flex; align-items: center; gap: 8px; color: var(--muted); }
      .mini-spark { width: 22px; height: 22px; fill: var(--accent); animation: pulse 1.6s infinite; }

      /* Compositor */
      .composer-wrap { width: 100%; max-width: 720px; }
      .error {
        background: var(--danger-bg); color: var(--danger); border-radius: 12px;
        padding: 10px 14px; margin-bottom: 10px; font-size: 0.93rem;
      }
      .composer {
        display: flex; align-items: flex-end; gap: 8px; background: var(--surface);
        border: 1px solid var(--border); border-radius: 28px; padding: 8px 8px 8px 22px;
        box-shadow: var(--shadow); transition: border-color .15s, box-shadow .15s;
      }
      .composer:focus-within { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); box-shadow: var(--shadow), 0 0 0 3px var(--accent-soft); }
      .composer textarea {
        flex: 1; min-width: 0; display: block; resize: none; border: 0; background: transparent; color: var(--text);
        font: inherit; line-height: 1.5; min-height: 24px; max-height: 200px; outline: none; padding: 8px 0; overflow-y: hidden;
      }
      .composer textarea::placeholder { color: var(--muted); }
      .count { align-self: center; font-size: 0.74rem; color: var(--muted); }
      .composer button {
        flex: none; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer; color: #fff;
        background: var(--accent); display: grid; place-items: center; transition: filter .15s;
      }
      .composer button:hover:not(:disabled) { filter: brightness(1.1); }
      .composer button:disabled, .composer textarea:disabled { opacity: .5; cursor: not-allowed; }
      .foot { padding: 6px 16px calc(10px + env(safe-area-inset-bottom)); text-align: center; color: var(--muted); font-size: 0.74rem; line-height: 1.45; }
      .foot p { margin: 0; text-wrap: balance; }

      /* Sugerencias */
      .suggestions {
        width: 100%; max-width: 720px; margin-top: 16px; display: flex; flex-wrap: wrap;
        justify-content: center; gap: 8px; animation: rise .6s ease both;
      }
      .sugg {
        display: inline-flex; align-items: center; gap: 8px; cursor: pointer; background: transparent;
        border: 1px solid var(--border); border-radius: 12px; padding: 9px 14px 9px 12px;
        font-size: 0.92rem; line-height: 1.3; transition: background-color .15s, border-color .15s;
      }
      .sugg:hover { background: var(--surface); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
      .sicon { display: grid; place-items: center; color: var(--muted); }
      .sugg:hover .sicon { color: var(--accent); }

      @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @keyframes pulse { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }

      /* ---------- Móvil ---------- */
      @media (max-width: 820px) {
        .only-mobile { display: grid; }
        #open-side { display: grid; }
        .sidebar {
          position: fixed; inset: 0 auto 0 0; z-index: 30; width: min(320px, 84vw);
          transform: translateX(-100%); transition: transform .22s ease; margin-left: 0 !important;
        }
        .layout.side-open .sidebar { transform: none; box-shadow: 0 0 40px rgba(0, 0, 0, 0.35); }
        .nav-item, .chat-item { min-height: 44px; }
        .more { width: 40px; height: 40px; opacity: 1; }
        .bar { padding: 6px 8px; }
        .stage { padding: 0 12px 6px; }
        .stage[data-empty='true'] { justify-content: flex-end; padding-bottom: 6px; }
        .stage[data-empty='true'] .hero { order: 1; margin: auto 0 22px; }
        .stage[data-empty='true'] .suggestions { order: 2; margin: 0 auto auto; max-width: 360px; }
        .stage[data-empty='true'] .composer-wrap { order: 3; }
        .hero h2 { font-size: 2rem; }
        .g-q { display: none; }
        .thread { gap: 24px; padding-top: 8px; }
        .msg.user .body { max-width: 88%; }
        .composer { padding-left: 18px; }
        .foot-src { display: none; }
        .foot { padding-top: 2px; font-size: 0.72rem; }
        .sugg { padding: 9px 12px 9px 10px; font-size: 0.9rem; white-space: nowrap; background: var(--surface); border-color: transparent; }
      }
    </style>
  </body>
</html>
